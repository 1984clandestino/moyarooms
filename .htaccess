# Sempre https://moyarooms.com (senza www)
RewriteEngine On
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://moyarooms.com/$1 [R=301,L]

# BEGIN link corti (generato da tools/build.py)
RewriteRule ^adriana/?$ /katania/apartament-przy-morzu/ [R=301,L]
RewriteRule ^peppe/?$ /katania/apartament-w-centrum/ [R=301,L]
RewriteRule ^iwona/?$ /palermo/apartament-przy-katedrze/ [R=301,L]
RewriteRule ^seba\-1/?$ /avola/apartament-w-centrum/ [R=301,L]
RewriteRule ^seba\-2/?$ /avola/apartament-z-basenem/ [R=301,L]
# END link corti

# Link corti per il modulo proprietari
RewriteRule ^(aggiungi|modulo-proprietari)/?$ /modulo/?lang=it [R=302,L]
RewriteRule ^(formularz|dodaj)/?$ /modulo/?lang=pl [R=302,L]
RewriteRule ^(dla-wlascicieli|wlasciciele)/?$ /proprietari/?lang=pl [R=302,L]

# File di lavoro non pubblici
RewriteRule ^(data|tools|_zgloszenia)/ - [F,L]
RewriteRule ^README\.md$ - [F,L]

# Cache per foto, font, stile e script
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType application/font-woff2 "access plus 1 year"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType text/javascript "access plus 7 days"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(jpg|jpeg|png|webp|svg)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
AddType image/webp .webp
AddType font/woff2 .woff2

ErrorDocument 404 /404.html
