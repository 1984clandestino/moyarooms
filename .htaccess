# Sempre https://moyarooms.com (senza www)
RewriteEngine On
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://moyarooms.com/$1 [R=301,L]

# BEGIN link corti (generato da tools/build.py)
RewriteRule ^adriana/?$ /katania/apartament-przy-morzu/ [R=301,L]
RewriteRule ^peppe/?$ /katania/apartament-w-centrum/ [R=301,L]
RewriteRule ^iwona/?$ /palermo/apartament-przy-katedrze/ [R=301,L]
RewriteRule ^seba\-1/?$ /avola/apartament-w-centrum/ [R=301,L]
RewriteRule ^seba\-2/?$ /avola/apartament-z-basenem/ [R=301,L]
# END link corti


# File di lavoro non pubblici
RewriteRule ^(data|tools)/ - [F,L]
RewriteRule ^README\.md$ - [F,L]

# Cache per foto e font
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 7 days"
</IfModule>

ErrorDocument 404 /404.html
